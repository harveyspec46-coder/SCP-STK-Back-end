# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_jwt_secret

# Database (from Supabase project settings → Database → Connection string)
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Server
PORT=8080
ENV=development

# Microsoft Graph (Phase 5 — email)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=

# Make.com (Phase 5 — WhatsApp)
MAKE_WEBHOOK_URL=
